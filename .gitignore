# =============================================================================
# EXCEPTIONS (Files that should NOT be ignored)
# =============================================================================

# Keep example environment files
!.env.example
!.env.template

# Keep sample configurations
!config/*.example
!config/*.sample

# Keep documentation
!docs/
!**/*.md

# Keep test fixtures
!tests/fixtures/
!tests/data/

# Keep exchange data
!exchanges/
!exchanges/*.json

# Keep schema
!schema.json

# Keep wrapper source
!wrappers/
!wrappers/**/src/

# =============================================================================
# END OF GITIGNORE
# =============================================================================
