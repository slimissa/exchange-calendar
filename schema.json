{
  "$id": "https://raw.githubusercontent.com/slimissa/exchange-calendar/main/schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Schema for a single exchange calendar file in the QuantOS exchange-calendar registry.",
  "properties": {
    "ad_hoc_closures": {
      "description": "Unplanned closures that cannot be generated by recurrence rules.",
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "early_close"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "early_close_time"
              ]
            }
          }
        ],
        "properties": {
          "date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "early_close_time": {
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "name": {
            "minLength": 3,
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "type": "string"
          },
          "status": {
            "enum": [
              "closed",
              "early_close"
            ],
            "type": "string"
          }
        },
        "required": [
          "date",
          "name",
          "status",
          "source_url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "code": {
      "description": "Exchange identifier. Must equal the ISO 10383 MIC.",
      "pattern": "^[A-Z0-9]{4}$",
      "type": "string"
    },
    "country": {
      "minLength": 1,
      "type": "string"
    },
    "country_code": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
    },
    "extended_hours": {
      "additionalProperties": false,
      "properties": {
        "after_hours": {
          "additionalProperties": false,
          "properties": {
            "close": {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            "open": {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            }
          },
          "required": [
            "open",
            "close"
          ],
          "type": "object"
        },
        "pre_market": {
          "additionalProperties": false,
          "properties": {
            "close": {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            "open": {
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            }
          },
          "required": [
            "open",
            "close"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "generation_range": {
      "description": "Inclusive date range [start, end] within which explicit dates are verified.",
      "items": {
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "holidays": {
      "additionalProperties": false,
      "properties": {
        "explicit": {
          "description": "Explicitly dated holidays and special sessions. This is the primary data source.",
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "early_close"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "early_close_time"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "delayed_open"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "delayed_open_time"
                  ]
                }
              }
            ],
            "properties": {
              "date": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "delayed_open_time": {
                "description": "Required when status is delayed_open.",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              "early_close_time": {
                "description": "Required when status is early_close.",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              "name": {
                "minLength": 3,
                "type": "string"
              },
              "predicted": {
                "default": false,
                "description": "True when this date is a calculated/estimated moon-sighting-dependent date (e.g. Islamic-calendar holidays) that has not yet been confirmed by an official announcement, and may still shift by a day. For backward compatibility, many existing entries instead encode this as a '(predicted)' suffix on `name` rather than this field -- both forms are currently accepted, but new entries should prefer this structured field since it's queryable without string-parsing `name`.",
                "type": "boolean"
              },
              "source_url": {
                "format": "uri",
                "type": "string"
              },
              "status": {
                "enum": [
                  "closed",
                  "early_close",
                  "delayed_open",
                  "special_session"
                ],
                "type": "string"
              },
              "weekend_exception": {
                "description": "Set true only when this date legitimately falls on the exchange's own weekend_days AND is still independently sourced as a distinct, exchange-gazetted event (e.g. a specific Muhurat trading session on Diwali). This is a deliberate, narrow override of the weekend-date validation check, not a general escape hatch -- do not set it just to silence a validation failure.",
                "type": "boolean"
              }
            },
            "required": [
              "date",
              "name",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "recurrence_rules": {
          "description": "Mechanically generatable holidays. Explicit dates take precedence.",
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "nth_weekday"
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                "then": {
                  "required": [
                    "month",
                    "weekday",
                    "n"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "last_weekday"
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                "then": {
                  "required": [
                    "month",
                    "weekday"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "easter_offset"
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                "then": {
                  "required": [
                    "offset_days"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "fixed_date"
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                "then": {
                  "required": [
                    "month",
                    "day"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "rule": {
                      "const": "fixed_with_weekend_adjustment"
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                "then": {
                  "required": [
                    "month",
                    "day"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "early_close"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "early_close_time"
                  ]
                }
              }
            ],
            "properties": {
              "day": {
                "maximum": 31,
                "minimum": 1,
                "type": "integer"
              },
              "early_close_time": {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "type": "string"
              },
              "month": {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              "n": {
                "description": "For nth_weekday rule: 1=first, 2=second, ..., 5=last",
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              "name": {
                "minLength": 3,
                "type": "string"
              },
              "offset_days": {
                "description": "For easter_offset rule: days relative to Easter Sunday (negative = before)",
                "type": "integer"
              },
              "rule": {
                "enum": [
                  "fixed_date",
                  "fixed_with_weekend_adjustment",
                  "nth_weekday",
                  "last_weekday",
                  "easter_offset"
                ],
                "type": "string"
              },
              "source_url": {
                "format": "uri",
                "type": "string"
              },
              "status": {
                "enum": [
                  "closed",
                  "early_close"
                ],
                "type": "string"
              },
              "weekday": {
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ],
                "type": "string"
              }
            },
            "required": [
              "rule",
              "name",
              "status"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "explicit"
      ],
      "type": "object"
    },
    "mic": {
      "description": "ISO 10383 Market Identifier Code. Must equal code.",
      "pattern": "^[A-Z0-9]{4}$",
      "type": "string"
    },
    "name": {
      "description": "Full exchange name.",
      "minLength": 3,
      "type": "string"
    },
    "regular_hours": {
      "additionalProperties": false,
      "properties": {
        "close": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        },
        "open": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "type": "string"
        }
      },
      "required": [
        "open",
        "close"
      ],
      "type": "object"
    },
    "sessions": {
      "description": "Additional non-trading periods within a regular day (e.g., lunch breaks, auctions).",
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "lunch_break"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "open",
                "close"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "auction"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "at"
              ]
            }
          }
        ],
        "properties": {
          "at": {
            "description": "Point-in-time session moment. Required for auction sessions.",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "close": {
            "description": "Session end time. Required for lunch_break sessions.",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "open": {
            "description": "Session start time. Required for lunch_break sessions.",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "type": "string"
          },
          "type": {
            "enum": [
              "lunch_break",
              "auction"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "timezone": {
      "description": "IANA timezone identifier.",
      "pattern": "^[A-Za-z0-9_+\\-]+/[A-Za-z0-9_+\\-]+(?:/[A-Za-z0-9_+\\-]+)?$",
      "type": "string"
    },
    "weekend_days": {
      "description": "The two weekday numbers (0=Monday..6=Sunday) that are non-trading weekend days for this exchange.",
      "items": {
        "maximum": 6,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "code",
    "name",
    "mic",
    "timezone",
    "weekend_days",
    "regular_hours",
    "holidays",
    "generation_range",
    "country",
    "country_code"
  ],
  "title": "Exchange Calendar Entry",
  "type": "object",
  "version": "2.0.0"
}
