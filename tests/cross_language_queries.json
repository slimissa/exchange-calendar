{
  "_comment": "Queries each wrapper must answer identically. holiday_entry returns the full stored entry for a date (null when none), so a wrapper that drops a field fails the diff. The check script runs these in Python, JavaScript, Rust, and Go, and diffs the outputs.",
  "queries": [
    {"op": "sessions",   "args": ["XNYS"],                             "label": "sessions_xnys"},
    {"op": "sessions",   "args": ["XTKS"],                             "label": "sessions_xtks"},
    {"op": "confidence", "args": ["XBUD", 2026],                       "label": "confidence_xbud_2026"},
    {"op": "confidence", "args": ["XNYS", 2026],                       "label": "confidence_xnys_2026"},
    {"op": "is_open",    "args": ["XNYS", "2026-01-02", "10:00"],      "label": "is_open_xnys_yes"},
    {"op": "is_open",    "args": ["XNYS", "2026-01-01", "10:00"],      "label": "is_open_xnys_holiday"},
    {"op": "as_of",      "args": ["XBUD", "2026-01-01"],               "label": "as_of_xbud_before_fetch"},
    {"op": "holiday_entry", "args": ["DSMD", "2025-03-31"],             "label": "holiday_dsmd_predicted_false"},
    {"op": "holiday_entry", "args": ["XCAI", "2027-03-09"],             "label": "holiday_xcai_predicted_true"},
    {"op": "holiday_entry", "args": ["XBOM", "2026-11-08"],             "label": "holiday_xbom_weekend_exception"},
    {"op": "holiday_entry", "args": ["XNYS", "2026-01-02"],             "label": "holiday_xnys_none"}
  ]
}
